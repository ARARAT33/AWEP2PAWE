/*
  Static security headers for Cloudflare Pages / compatible static hosts.
*/
/*
  Do not put frame-ancestors in the HTML meta CSP: browsers ignore it there.
*/
/*
  Keep the CSP aligned with index.html so the QR CDN and local runtime work.
*/
/*
  If the host supports _headers, these headers are authoritative.
*/
/*
  / is intentionally used as the catch-all path.
*/
/*
  Cloudflare Pages syntax:
*/
/*
  /
    X-Frame-Options: DENY
    Referrer-Policy: no-referrer
    X-Content-Type-Options: nosniff
    Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=()
    Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
*/
